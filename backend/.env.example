# Copy to backend/.env and fill in locally. Never commit the real .env.
# Keys live ONLY on the Python server; the Next.js frontend never receives them.

# ---- Where this runs ---------------------------------------------------------------
# local (default) | hosted = any shared deployment: startup refuses unsafe settings (CORS wildcard/localhost,
# missing STAFF_API_TOKEN, GATE_OVERRIDE_ENABLED=true, no DATABASE_URL). "hosted" is not "production ready".
APP_ENV=local

# ---- Default target for /api/chat --------------------------------------------
# gemini (intended for deployments) | openrouter (free models) | ollama (local) | anthropic (optional)
# | mock (deterministic templates, NOT a language model; use it when no key is available)
LLM_PROVIDER=mock
# Empty = the provider's default (gemini -> GEMINI_MODEL). For openrouter set e.g. nvidia/nemotron-3.5-super-vl:free;
# for mock set mock-deterministic-v1.
LLM_MODEL=mock-deterministic-v1
# Optional generic overrides applied to the default provider only:
LLM_API_KEY=
LLM_BASE_URL=

# ---- Shared generation settings (identical for baseline and aware) ------------
LLM_TEMPERATURE=0.2
# Reasoning models (e.g. nemotron) spend part of this budget on hidden reasoning; 1200 nearly truncated.
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Retries on 429/5xx/timeouts use the SAME model; models are never silently switched.
LLM_MAX_RETRIES=2

# ---- Provider-specific ----------------------------------------------------------
# Gemini Developer API key from https://aistudio.google.com (backend only; never in the website). Check the model
# without generating anything: uv run python -m app.live_eval.preflight
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: pin thinking (minimal | low | medium | high); empty = the model's default. Temperature is not sent to Gemini.
GEMINI_THINKING_LEVEL=
# Free key: https://openrouter.ai/keys . Free models may log prompts: synthetic/de-identified data only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local models: `ollama serve` then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
# Optional: requires `uv sync --extra anthropic`
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium

# ---- Decision gate (docs/architecture/decision-gate.md) ------------------------------------------
# rules (default, deterministic, free) | llm (one extra model call per turn) | jev (EXPERIMENTAL, needs key)
# Rules always run as the safety floor; llm/jev failures fall back to rules and are recorded.
DECISION_GATE_PROVIDER=rules
# provider:model for the llm gate; empty = the chat default target
DECISION_GATE_LLM_TARGET=
DECISION_GATE_TIMEOUT_SECONDS=8
# Let the browser choose a gate per turn / run llm gate comparisons (code default false).
# Set true only for local experiments; keep false on any shared deployment.
GATE_OVERRIDE_ENABLED=false
# Jev (TypeSafe AI) — paid key from typesafe.ai; response schema undocumented, adapter is experimental.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ---- Targets offered in the eval dashboard (provider:model, comma-separated) -----
EVAL_TARGETS=mock:mock-deterministic-v1,gemini:gemini-3.6-flash,openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:google/gemma-4-31b-it:free,openrouter:dots-studio/dots-3-note-preview:free,ollama:llama3.2

# ---- Local paths (relative to backend/) -------------------------------------------
DATA_PATH=data/um_ai_sprint_sample_residents.xlsx
DB_PATH=data/mckinley_demo.sqlite3
# Optional: a Postgres connection string (Supabase "Session pooler" or "Transaction pooler" URI). When set, saved
# chats and requests go to Postgres instead of the SQLite file. A secret: set it in the host's settings, never commit.
DATABASE_URL=
# auto = the workbook file if present, else the synthetic rows loaded by `python -m app.seed_synthetic`; file; database
RESIDENT_DATA_SOURCE=auto
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Semantic safety classifier (layer 2; docs/safety/safety-evaluation.md) ----------------
# auto = runs when the target provider has a key and is not the mock (one extra model call per turn); off = never.
# It never removes a rules alert; it may only drop the broad 911 care line (policy R7, confidence >= 0.8).
SAFETY_CLASSIFIER=auto
SAFETY_CLASSIFIER_TARGET=
SAFETY_CLASSIFIER_TIMEOUT_SECONDS=6

# ---- Staff / demo routes ---------------------------------------------------------------------
# Empty = staff, eval, gate and records routes answer only direct requests from this machine.
# Any shared deployment must set a long random token (sent as the X-Staff-Token header). Not real sign-in.
STAFF_API_TOKEN=
