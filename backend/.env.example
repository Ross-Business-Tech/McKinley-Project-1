# Copy to backend/.env and fill in locally. Never commit the real .env.
# Keys live ONLY on the Python server; the Next.js frontend never receives them.

# ---- Default target for /api/chat --------------------------------------------
# openrouter (default, free models) | ollama (local) | mock (deterministic, NOT a language model) | anthropic (optional)
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional generic overrides applied to the default provider only:
LLM_API_KEY=
LLM_BASE_URL=

# ---- Shared generation settings (identical for baseline and aware) ------------
LLM_TEMPERATURE=0.2
# Reasoning models (e.g. nemotron) spend part of this budget on hidden reasoning; 1200 nearly truncated.
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Retries on 429/5xx/timeouts use the SAME model; models are never silently switched.
LLM_MAX_RETRIES=2

# ---- Provider-specific ----------------------------------------------------------
# Free key: https://openrouter.ai/keys . Free models may log prompts: synthetic/de-identified data only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local models: `ollama serve` then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
# Optional: requires `uv sync --extra anthropic`
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium

# ---- Decision gate (docs/GATE_DESIGN.md) ------------------------------------------
# rules (default, deterministic, free) | llm (one extra model call per turn) | jev (EXPERIMENTAL, needs key)
# Rules always run as the safety floor; llm/jev failures fall back to rules and are recorded.
DECISION_GATE_PROVIDER=rules
# provider:model for the llm gate; empty = the chat default target
DECISION_GATE_LLM_TARGET=
DECISION_GATE_TIMEOUT_SECONDS=8
# Let the browser choose a gate per turn / run llm gate comparisons. Set false on any shared deployment.
GATE_OVERRIDE_ENABLED=true
# Jev (TypeSafe AI) — paid key from typesafe.ai; response schema undocumented, adapter is experimental.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ---- Targets offered in the eval dashboard (provider:model, comma-separated) -----
EVAL_TARGETS=mock:mock-deterministic-v1,openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:google/gemma-4-31b-it:free,openrouter:dots-studio/dots-3-note-preview:free,ollama:llama3.2

# ---- Local paths (relative to backend/) -------------------------------------------
DATA_PATH=data/um_ai_sprint_sample_residents.xlsx
DB_PATH=data/mckinley_demo.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
