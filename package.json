{
  "name": "starter-template",
  "private": true,
  "version": "0.1.0",
  "description": "McKinley context-aware AI assistant prototype (Next.js frontend in frontend/, FastAPI backend in backend/)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "postinstall": "npm --prefix frontend ci --no-audit --no-fund",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build:static",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix frontend test",
    "backend:dev": "uv --directory backend run uvicorn app.main:app --reload --port 8000",
    "backend:test": "uv --directory backend run pytest",
    "smoke": "node scripts/smoke-test.cjs",
    "publish:preview": "node scripts/herenow-publish.mjs preview"
  }
}
