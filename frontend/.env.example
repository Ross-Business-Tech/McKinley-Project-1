# Public base URL of the FastAPI backend. This is NOT a secret; never put LLM API keys in frontend env files.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: real sign-in with Supabase (docs/security/SUPABASE_AUTH.md). Leave BOTH empty and the page shows no sign-in.
# Both values are PUBLIC and are baked in at build time. Use the publishable (anon) key, NEVER the secret / service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
